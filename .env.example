# Laptop profile (developer machine, small GPU). Copy to .env and adjust.
# On the DGX use .env.dgx.example instead.

COMPOSE_PROFILES=local

# Shown in the UI header: "milOS-DGX Quickstart | <CLIENT_NAME>"
CLIENT_NAME=Cliente

# --- Model server (Ollama) ---
OLLAMA_TAG=0.40.18
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# --- Models (must fit in ~4 GB of VRAM; one loaded at a time) ---
LLM_MODEL=qwen3:4b-instruct
VLM_MODEL=qwen3-vl:4b-instruct

# Reasoning effort for LLM_MODEL (low, medium, high). Empty: qwen3:4b-instruct does not reason.
LLM_REASONING_EFFORT=

# --- Endpoints (OpenAI-compatible). Point these at a cloud endpoint to skip local models. ---
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
VLM_BASE_URL=http://ollama:11434/v1
VLM_API_KEY=ollama

# --- Jupyter ---
# The NGC image is ~20 GB on disk; it is the same image the DGX uses.
JUPYTER_BASE_IMAGE=nvcr.io/nvidia/pytorch:26.11-py3
JUPYTER_TOKEN=workshop
