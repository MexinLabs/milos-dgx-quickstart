# DGX Spark profile (arm64, 128 GB of memory shared by CPU and GPU).
# Copy to .env on the Spark and adjust.

COMPOSE_PROFILES=dgx

# Shown in the UI header: "milOS-DGX Quickstart | <CLIENT_NAME>"
CLIENT_NAME=Cliente

# --- Model server (Ollama) ---
OLLAMA_TAG=0.40.18
# Keep models in memory for the whole session: no cold start during a demo.
OLLAMA_KEEP_ALIVE=-1
# Concurrent requests per model: needed for the parallel-requests demo.
# Each parallel slot reserves its own context memory, so do not raise it blindly.
OLLAMA_NUM_PARALLEL=4
# How many models stay in memory at once. Loading one more evicts the least recently used.
OLLAMA_MAX_LOADED_MODELS=3
# Tokens of context per request. Keep it set: without it Ollama takes the model's
# maximum on a machine this size (262,144 for Qwen3, times OLLAMA_NUM_PARALLEL)
# and the model fails to load. 8192 fits a full-size photo (about 4,000 tokens)
# plus the answer. Each loaded model reserves this many tokens per parallel slot.
OLLAMA_CONTEXT_LENGTH=8192

# --- Models (Qwen family, all Apache 2.0). Sizes are download sizes. ---
# The defaults are the small pair, so a new machine is running in minutes:
#
#   qwen3:4b-instruct      2.5 GB  chat and agents (tool calling)
#   qwen3-vl:4b-instruct   3.3 GB  vision
#
# Larger models to download afterwards with ./scripts/download-model.sh <model>:
#
#   qwen3:30b-instruct     18.6 GB  much better agents; then set LLM_MODEL to it
#   qwen3-vl:8b-instruct    6.2 GB  better vision; then set VLM_MODEL to it
#   qwen3-vl:32b-instruct  20.9 GB  best vision
#   qwen3-next:80b         50.4 GB  an 80B model that does not fit on a normal
#                                   workstation; it reasons before answering
#
# After changing a model here: docker compose up -d backend jupyter
# Use the -instruct builds: the plain tags are thinking builds, slow for live use.
LLM_MODEL=qwen3:4b-instruct
VLM_MODEL=qwen3-vl:4b-instruct

# Reasoning effort for LLM_MODEL (low, medium, high). Only for a model that
# reasons; the -instruct models do not, so it stays empty.
LLM_REASONING_EFFORT=

# --- Endpoints (OpenAI-compatible protocol, served locally by Ollama) ---
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
VLM_BASE_URL=http://ollama:11434/v1
VLM_API_KEY=ollama

# --- Jupyter ---
JUPYTER_BASE_IMAGE=nvcr.io/nvidia/pytorch:26.11-py3
JUPYTER_TOKEN=workshop
