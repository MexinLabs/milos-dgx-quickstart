# DGX Spark profile (arm64, 128 GB of memory shared by CPU and GPU).
# Copy to .env on the Spark and adjust.

COMPOSE_PROFILES=dgx

# Shown in the UI header: "milOS-DGX Quickstart | <CLIENT_NAME>"
CLIENT_NAME=Cliente

# --- Model server (Ollama) ---
OLLAMA_TAG=0.40.18
# Keep models in memory for the whole session: no cold start during a demo.
OLLAMA_KEEP_ALIVE=-1
# Concurrent requests per model: needed for the parallel-agents demo.
# Each parallel slot reserves its own context memory, so do not raise it blindly.
OLLAMA_NUM_PARALLEL=4
# LLM + VLM stay loaded together. Loading SHOWCASE_MODEL evicts one of them.
OLLAMA_MAX_LOADED_MODELS=2

# --- Models (Qwen family, all Apache 2.0). Sizes are download sizes. ---
# Memory is shared with Jupyter and the OS: LLM + VLM use about 40 GB,
# the showcase model about 50 GB more while it is loaded.
#
# qwen3:30b-instruct      18.6 GB  drives the agents (tool calling). The -instruct build
#                                  answers directly; the plain tag is the thinking build.
# qwen3-vl:32b-instruct   20.9 GB  vision. If it is slow live, use qwen3-vl:8b-instruct (6.2 GB).
# qwen3-next:80b          50.4 GB  showcase: an 80B model that does not fit on a normal
#                                  workstation. It reasons before answering.
#                                  Optional: delete the line to skip the download.
LLM_MODEL=qwen3:30b-instruct
VLM_MODEL=qwen3-vl:32b-instruct
SHOWCASE_MODEL=qwen3-next:80b

# Reasoning effort for LLM_MODEL (low, medium, high). Only for a model that
# reasons; qwen3:30b-instruct does not, so it stays empty.
LLM_REASONING_EFFORT=

# --- Endpoints (OpenAI-compatible protocol, served locally by Ollama) ---
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
VLM_BASE_URL=http://ollama:11434/v1
VLM_API_KEY=ollama

# --- Jupyter ---
JUPYTER_BASE_IMAGE=nvcr.io/nvidia/pytorch:26.11-py3
JUPYTER_TOKEN=workshop
